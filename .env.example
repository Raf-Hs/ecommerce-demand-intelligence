# Docker Compose (see infrastructure/docker-compose.yml)
# Run: docker compose -f infrastructure/docker-compose.yml --env-file .env up -d

# Paths
DATA_ROOT=./data
RAW_DIR=./data/raw
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold

# PostgreSQL (serving layer, optional in early phases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce_demand
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# Logging
LOG_LEVEL=INFO
